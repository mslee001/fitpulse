# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Database — leave blank to use local SQLite, set to Neon URL to use Postgres
# DATABASE_URL=postgres://user:pass@host/dbname?sslmode=require

# Peloton — not set here. Each person pastes their peloton_session_id cookie on
# /settings/integrations/ (or Get Started); it's stored per user in the database.
# PELOTON_SESSION_ID / PELOTON_USER_ID are only read by the one-time
# migrate_peloton_creds command.

# Email — welcome emails for new household members, sent from a Gmail account.
# Turn on 2-Step Verification, then create an app password at
# https://myaccount.google.com/apppasswords. Leave blank locally: emails print
# to the console instead.
EMAIL_HOST_USER=you@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-app-password

# Anthropic (Claude API) — https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Garmin Connect — used by the garminconnect library for first-time auth
# Run: venv/bin/python3 manage.py garmin_login
GARMIN_EMAIL=your-garmin-email@example.com
GARMIN_PASSWORD=your-garmin-password

# Withings OAuth 2.0 — create an app at https://developer.withings.com/
# Register https://<your-host>/auth/withings/callback/ (and the localhost one for testing)
# as callback URLs, then use "Connect Withings" on /settings/integrations/.
# WITHINGS_REDIRECT_URI is only used by the CLI: manage.py withings_login [--user USERNAME]
WITHINGS_CLIENT_ID=your-withings-client-id
WITHINGS_CLIENT_SECRET=your-withings-client-secret
WITHINGS_REDIRECT_URI=http://localhost:8000/auth/withings/callback/
# Where Withings posts weigh-in notifications (one URL for every user)
WITHINGS_CALLBACK_URL=https://your-host/api/withings/webhook/

# Google Health OAuth 2.0 — add each household member as a Test user on the
# Google Cloud OAuth consent screen, then use "Connect" on /settings/integrations/.
# GOOGLE_HEALTH_REDIRECT_URI is only used by the CLI: manage.py google_health_login
GOOGLE_HEALTH_CLIENT_ID=your-google-client-id
GOOGLE_HEALTH_CLIENT_SECRET=your-google-client-secret
GOOGLE_HEALTH_REDIRECT_URI=http://localhost:8000/auth/google-health/callback/
GOOGLE_HEALTH_WEBHOOK_SECRET=shared-secret-for-the-webhook-authorization-header
# Temporary: keep the first 3 webhook payloads for review (set 0 to stop)
GOOGLE_HEALTH_CAPTURE_PAYLOADS=1
